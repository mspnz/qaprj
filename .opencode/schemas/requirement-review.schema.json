{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RequirementReviewArtifact",
  "type": "object",
  "required": [
    "metadata",
    "feature_scope",
    "requirements",
    "business_rules",
    "constraints",
    "acceptance_criteria",
    "dependencies",
    "defects",
    "risks"
  ],
  "additionalProperties": false,
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["confluence_page_id", "run_timestamp"],
      "additionalProperties": false,
      "properties": {
        "confluence_page_id": { "type": "string", "pattern": "^[0-9]+$" },
        "run_timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{2}-[0-9]{2}$" }
      }
    },
    "feature_scope": { "type": "string", "minLength": 1 },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description", "status", "blocker_refs"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^REQ-[0-9]+$" },
          "description": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["confirmed", "blocked"] },
          "blocker_refs": {
            "type": "array",
            "items": { "type": "string", "pattern": "^(AMB|CNT|MIS)-[0-9]+$" }
          }
        }
      }
    },
    "business_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description", "linked_req_ids"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^BR-[0-9]+$" },
          "description": { "type": "string", "minLength": 1 },
          "linked_req_ids": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^REQ-[0-9]+$" }
          }
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description", "linked_req_ids"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^CON-[0-9]+$" },
          "description": { "type": "string", "minLength": 1 },
          "linked_req_ids": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^REQ-[0-9]+$" }
          }
        }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description", "linked_req_ids"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^AC-[0-9]+$" },
          "description": { "type": "string", "minLength": 1 },
          "linked_req_ids": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^REQ-[0-9]+$" }
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_req_id", "target", "description"],
        "additionalProperties": false,
        "properties": {
          "source_req_id": { "type": "string", "pattern": "^REQ-[0-9]+$" },
          "target": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "defects": {
      "type": "object",
      "required": ["ambiguities", "contradictions", "missing_info"],
      "additionalProperties": false,
      "properties": {
        "ambiguities": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "severity", "description", "affected_req_ids", "question_to_owner"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^AMB-[0-9]+$" },
              "severity": { "type": "string", "enum": ["Blocker", "Major", "Minor"] },
              "description": { "type": "string", "minLength": 1 },
              "affected_req_ids": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "pattern": "^REQ-[0-9]+$" }
              },
              "question_to_owner": { "type": "string", "minLength": 1 }
            }
          }
        },
        "contradictions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "severity", "description", "affected_req_ids", "question_to_owner"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^CNT-[0-9]+$" },
              "severity": { "type": "string", "enum": ["Blocker", "Major", "Minor"] },
              "description": { "type": "string", "minLength": 1 },
              "affected_req_ids": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "pattern": "^REQ-[0-9]+$" }
              },
              "question_to_owner": { "type": "string", "minLength": 1 }
            }
          }
        },
        "missing_info": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "severity", "description", "affected_req_ids", "question_to_owner"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^MIS-[0-9]+$" },
              "severity": { "type": "string", "enum": ["Blocker", "Major", "Minor"] },
              "description": { "type": "string", "minLength": 1 },
              "affected_req_ids": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "pattern": "^REQ-[0-9]+$" }
              },
              "question_to_owner": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "description", "linked_req_ids"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^RISK-[0-9]+$" },
          "severity": { "type": "string", "enum": ["Blocker", "Major", "Minor"] },
          "description": { "type": "string", "minLength": 1 },
          "linked_req_ids": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^REQ-[0-9]+$" }
          }
        }
      }
    }
  }
}