{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "JiraTasksArtifact",
  "type": "object",
  "required": ["metadata", "tasks", "coverage_summary"],
  "additionalProperties": false,
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["confluence_page_id", "run_timestamp", "jira_project_key"],
      "additionalProperties": false,
      "properties": {
        "confluence_page_id": { "type": "string", "pattern": "^[0-9]+$" },
        "run_timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{2}-[0-9]{2}$" },
        "jira_project_key": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "local_id",
          "summary",
          "description",
          "acceptance_criteria",
          "dependencies",
          "linked_requirement_ids",
          "export_status",
          "jira_issue_key"
        ],
        "additionalProperties": false,
        "properties": {
          "local_id": { "type": "string", "pattern": "^TASK-[0-9]+$" },
          "summary": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "acceptance_criteria": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "dependencies": {
            "type": "array",
            "items": { "type": "string", "pattern": "^TASK-[0-9]+$" }
          },
          "linked_requirement_ids": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^REQ-[0-9]+$" }
          },
          "export_status": {
            "type": "string",
            "enum": ["pending", "exported", "existing", "failed"]
          },
          "jira_issue_key": {
            "type": ["string", "null"],
            "pattern": "^[A-Z][A-Z0-9_]*-[0-9]+$"
          }
        }
      }
    },
    "coverage_summary": {
      "type": "object",
      "required": ["covered_requirement_ids", "skipped_requirements"],
      "additionalProperties": false,
      "properties": {
        "covered_requirement_ids": {
          "type": "array",
          "items": { "type": "string", "pattern": "^REQ-[0-9]+$" }
        },
        "skipped_requirements": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["req_id", "blocker_refs", "reason"],
            "additionalProperties": false,
            "properties": {
              "req_id": { "type": "string", "pattern": "^REQ-[0-9]+$" },
              "blocker_refs": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "pattern": "^(AMB|CNT|MIS)-[0-9]+$" }
              },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}